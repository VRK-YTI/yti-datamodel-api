            "should": [
              {
                "multi_match": {
                  "boost": 3.0,
                  "fields": ["label.*"],
                  "operator": "and",
                  "query": "test"
                }
              },
              {
                "multi_match": {
                  "boost": 2.0,
                  "fields": ["label.*.edge"],
                  "operator": "and",
                  "query": "test"
                }
              },
              {
                "multi_match": {
                  "fields": ["label.*.ngram"],
                  "operator": "and",
                  "query": "test"
                }
              }
            ]
          }
        },
        {
          "bool": {
            "minimum_should_match": "1",
            "should": [
              { "terms": { "namespace": ["http://external-data.com/test"] } },
              {
                "terms": {
                  "versionIri": ["https://iri.suomi.fi/model/addedNs/1.0.0/"]
                }
              },
              { "terms": { "id": [] } }
            ]
          }
        },
        { "terms": { "resourceType": ["ATTRIBUTE", "ASSOCIATION"] } },
        {
          "term": {
            "targetClass": {
              "value": "https://iri.suomi.fi/model/test/TestClass"
            }
          }
        }
      ],
      "should": [
        {
          "terms": {
            "isDefinedBy": [
              "https://iri.suomi.fi/model/test/",
              "https://iri.suomi.fi/model/draft_model/"
            ]
          }
        },
        {
          "bool": {
            "must_not": [{ "term": { "status": { "value": "DRAFT" } } }]
